# syntax=docker/dockerfile:1.7
#
# Thin main-training image.  It deliberately reuses the successfully pushed
# fixed-trajectory ALFWorld image, whose largest layer is the exact packed
# skillRL environment.  This reduces registry I/O only; all four Tree-RL
# launchers, data contracts, and training hyperparameters remain unchanged.
ARG BASE_IMAGE=coskill-alfworld-fixed-ablation:skillrl-cu128
FROM ${BASE_IMAGE}

# vLLM profiles the model at startup.  On CUDA GPUs this can invoke
# torch.compile/Triton, which JIT-compiles a small extension and therefore
# requires a host C/C++ toolchain.  The ablation parent intentionally omitted
# compilers, so install only the standard build tools here.  This affects
# startup capability/cache construction, not training data or hyperparameters.
ARG UBUNTU_APT_MIRROR=https://mirrors.aliyun.com/ubuntu
RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list \
    && sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|https://archive.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|https://security.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && gcc --version >/dev/null \
    && g++ --version >/dev/null \
    && make --version >/dev/null \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/conda/envs/skillRL/bin:$PATH \
    CONDA_DEFAULT_ENV=skillRL \
    PYTHONUNBUFFERED=1 \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    FAISS_OPT_LEVEL=AVX2 \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    COSKILL_CONTAINER=1 \
    PROJECT_ROOT=/workspace/CoSkill \
    PYTHONPATH=/workspace/CoSkill \
    ALFWORLD_DATA=/opt/data/alfworld \
    DATA_ROOT=/opt/data/verl-agent \
    OUTPUT_ROOT=/outputs \
    MODEL_PATH=/models/Qwen3-4B-Thinking-2507 \
    WEBSHOP_DATA_DIR=/workspace/CoSkill/agent_system/environments/env_package/webshop/webshop/data

WORKDIR /workspace/CoSkill

# The fixed-trajectory protocol keeps its own runner while this unified image
# overlays the current source checkout for both ablation and main Tree-RL.
COPY --from=coskill_source . /workspace/CoSkill

# Import from the source copied above rather than editable pointers retained
# by the packed environment.  Remove the unused SkyRL package so the runtime
# package set matches the standalone main image.  Avoid an editable install:
# the legacy tqdm/datasets metadata conflict is unrelated to runtime imports
# but blocks pip's dependency metadata resolver.
RUN python -m pip uninstall -y skyrl-gym >/dev/null 2>&1 || true \
    && python -c 'import verl; assert "/workspace/CoSkill" in verl.__file__, verl.__file__'

# The ablation image was built from an older archive whose faiss package has
# the same version but different Python wrapper files.  Overlay the exact
# current skillRL runtime copy so full and shared main images agree, including
# if an embedding retrieval mode is used.
COPY --from=runtime_assets faiss-runtime-overlay.tar.gz /tmp/faiss-runtime-overlay.tar.gz
RUN site=/opt/conda/envs/skillRL/lib/python3.10/site-packages \
    && rm -rf "$site/faiss" "$site"/faiss-*.egg-info \
              "$site"/faiss_cpu-*.dist-info "$site/faiss_cpu.libs" \
    && tar -xzf /tmp/faiss-runtime-overlay.tar.gz -C "$site" \
    && rm /tmp/faiss-runtime-overlay.tar.gz \
    && python -c 'import faiss; assert faiss.__version__ == "1.13.2"'

# Do not assume the ablation parent carries the GRPO parquet cache: it is
# intentionally self-contained here so all main Tree-RL entrypoints work on a
# fresh server.  The archive contains exactly train=12 and test=32 rows.
COPY --from=runtime_assets prepared-verl-data.tar.gz /tmp/prepared-verl-data.tar.gz
RUN mkdir -p /opt/data \
    && tar -xzf /tmp/prepared-verl-data.tar.gz -C /opt/data \
    && rm /tmp/prepared-verl-data.tar.gz \
    && test -f /opt/data/verl-agent/text/train.parquet \
    && test -f /opt/data/verl-agent/text/test.parquet

# The parent already has ALFWorld.  Main Tree-RL additionally needs the fixed
# 1,000-product WebShop split and the matching Lucene index.
COPY --from=webshop_assets webshop-small-data.tar.gz /tmp/webshop-small-data.tar.gz
RUN tar -xzf /tmp/webshop-small-data.tar.gz \
        -C /workspace/CoSkill/agent_system/environments/env_package/webshop/webshop \
    && rm /tmp/webshop-small-data.tar.gz \
    && mkdir -p /outputs /models \
    && chmod +x docker/coskill/entrypoint.sh

ENTRYPOINT ["/workspace/CoSkill/docker/coskill/entrypoint.sh"]
CMD ["preflight"]
