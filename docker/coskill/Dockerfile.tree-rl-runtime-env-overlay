# Runtime-only Tree-RL overlay for a packed CoSkill image.
#
# It deliberately does not COPY .env, credentials, model weights, data, logs,
# checkpoints, or arbitrary worktree files.  At runtime mount a dotfile at
# /workspace/CoSkill/.env:ro (or /run/secrets/coskill.env:ro); the entrypoint
# parses it with the bundled Python allowlist before the mandatory real cloud
# probe.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /workspace/CoSkill

COPY docker/coskill/entrypoint.sh /workspace/CoSkill/docker/coskill/entrypoint.sh
COPY examples/grpo_trainer/run_coskill_tree_rl.sh /workspace/CoSkill/examples/grpo_trainer/run_coskill_tree_rl.sh
COPY examples/grpo_trainer/run_coskill_tree_rl_8xa800.sh /workspace/CoSkill/examples/grpo_trainer/run_coskill_tree_rl_8xa800.sh
COPY scripts/load_container_cloud_env.py /workspace/CoSkill/scripts/load_container_cloud_env.py
COPY scripts/configure_vllm_acceleration.sh /workspace/CoSkill/scripts/configure_vllm_acceleration.sh
COPY scripts/preflight_wandb.py /workspace/CoSkill/scripts/preflight_wandb.py
COPY scripts/preflight_tree_rl_runtime.py /workspace/CoSkill/scripts/preflight_tree_rl_runtime.py
# Tree-only cloud evidence is a cross-module protocol: the trainer creates a
# TracesPool, CoSkillCloudLoop forwards its exported batch, and CloudAnalyzer
# renders the codec.  Overlay the whole memory package as one coherent unit;
# copying only ray_trainer.py against the older packed package makes the first
# watermark update fail with an unexpected keyword/schema error.
COPY agent_system/memory/ /workspace/CoSkill/agent_system/memory/
COPY verl/trainer/ppo/ray_trainer.py /workspace/CoSkill/verl/trainer/ppo/ray_trainer.py

RUN chmod +x \
    /workspace/CoSkill/docker/coskill/entrypoint.sh \
    /workspace/CoSkill/examples/grpo_trainer/run_coskill_tree_rl.sh \
    /workspace/CoSkill/examples/grpo_trainer/run_coskill_tree_rl_8xa800.sh \
    /workspace/CoSkill/scripts/load_container_cloud_env.py \
    /workspace/CoSkill/scripts/configure_vllm_acceleration.sh \
    /workspace/CoSkill/scripts/preflight_tree_rl_runtime.py \
    && test -f /workspace/CoSkill/scripts/load_private_env.sh \
    && test -f /workspace/CoSkill/scripts/check_cloud_bootstrap.py \
    && test -f /workspace/CoSkill/scripts/preflight_wandb.py \
    && test -f /workspace/CoSkill/examples/data_preprocess/prepare.py \
    && test -f /workspace/CoSkill/verl/trainer/main_ppo.py \
    && bash -n /workspace/CoSkill/docker/coskill/entrypoint.sh \
    && bash -n /workspace/CoSkill/examples/grpo_trainer/run_coskill_tree_rl.sh \
    && bash -n /workspace/CoSkill/examples/grpo_trainer/run_coskill_tree_rl_8xa800.sh \
    && python -m py_compile /workspace/CoSkill/verl/trainer/ppo/ray_trainer.py \
    && python /workspace/CoSkill/scripts/preflight_tree_rl_runtime.py

ENTRYPOINT ["/workspace/CoSkill/docker/coskill/entrypoint.sh"]
CMD ["preflight"]
