.git
.github
.pytest_cache
**/__pycache__
**/*.pyc
.env
.env.*
!.env.example

outputs
skillrl_outputs
smoke_outputs
# Prepared parquet is runtime-derived.  The thin image inherits the checked
# 12/32 files from its ablation parent; never overwrite them with a local
# smoke-test-sized cache during source overlay.
skillrl_data
training.log
**/*.log
**/global_step_*
**/checkpoints

# The dedicated build script packs only the small WebShop split and ALFWorld
# text-game assets into docker/coskill/assets/*.tar.gz.
agent_system/environments/env_package/webshop/webshop/data
agent_system/environments/env_package/webshop/webshop/search_engine/indexes
mini_test_pen_shelf/output*
mini_test_pen_shelf/backups

# Keep the generated Docker assets in the build context.  They are ignored by
# Git and supplied through a separate BuildKit named context.
docker/coskill/assets
